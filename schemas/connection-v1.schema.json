{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "controller": {
      "enum": [
        "stm_sys_board",
        "kasli"
      ]
    },
    "transport": {
      "enum": [
        "serial_wb",
        "litex_remote"
      ]
    },
    "address": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "timeout_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 30
    },
    "gateware_abi": {
      "const": "sinara-gpio-v1"
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "type": "integer",
            "minimum": 0,
            "maximum": 11
          },
          "mosi": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "miso": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "clk": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "cs": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "minItems": 3,
            "maxItems": 3
          },
          "pinmux": {
            "enum": [
              "urukul_eem0"
            ]
          }
        },
        "required": [
          "endpoint",
          "mosi",
          "miso",
          "clk",
          "cs"
        ]
      }
    },
    "csr_map": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "use": {
      "enum": [
        "simulation",
        "hardware"
      ]
    }
  },
  "required": [
    "schema_version",
    "controller",
    "transport",
    "address",
    "timeout_s",
    "gateware_abi",
    "bindings",
    "csr_map",
    "use"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
